<div class="min-h-screen bg-gray-50 pb-20">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <h1 class="text-2xl font-bold text-gray-900 mb-4">Explore Skills</h1>
      
      <!-- Search Bar -->
      <div class="flex gap-3">
        <div class="flex-1 relative">
          <lucide-icon [img]="Search" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"></lucide-icon>
          <input
            type="text"
            placeholder="Search by name or skill..."
            (input)="onSearchChange($any($event.target).value)"
            class="w-full text-gray-700 pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>
        <button
          (click)="toggleFilters()"
          class="flex items-center text-gray-700 gap-2 px-4 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors relative"
          [class.bg-indigo-50]="showFilters()"
          [class.border-indigo-300]="showFilters()"
        >
          <lucide-icon [img]="Filter" class="w-5 h-5"></lucide-icon>
          <span class="font-medium hidden sm:inline">Filters</span>
          <span *ngIf="activeFiltersCount() > 0" class="absolute -top-2 -right-2 bg-indigo-600 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
            {{ activeFiltersCount() }}
          </span>
        </button>
      </div>

      <!-- Filters Panel -->
      <div *ngIf="showFilters()" class="mt-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-gray-900">Filters</h3>
          <button
            (click)="clearFilters()"
            class="text-sm text-indigo-600 hover:text-indigo-700 font-medium"
            *ngIf="activeFiltersCount() > 0"
          >
            Clear All
          </button>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Skill Taught Filter -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Skill They Teach</label>
            <input
              type="text"
              [value]="filters().skillTaught"
              (input)="updateFilter('skillTaught', $any($event.target).value)"
              placeholder="e.g., JavaScript"
              class="w-full text-gray-700 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <!-- Skill Wanted Filter -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Skill They Want</label>
            <input
              type="text"
              [value]="filters().skillWanted"
              (input)="updateFilter('skillWanted', $any($event.target).value)"
              placeholder="e.g., Python"
              class="w-full px-3 py-2 text-gray-700 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <!-- Skill Level Filter -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Skill Level</label>
            <select
              [value]="filters().skillLevel"
              (change)="updateFilter('skillLevel', $any($event.target).value)"
              class="w-full text-gray-700 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
              <option value="">All Levels</option>
              <option [value]="SkillLevel.BEGINNER">Beginner</option>
              <option [value]="SkillLevel.INTERMEDIATE">Intermediate</option>
              <option [value]="SkillLevel.ADVANCED">Advanced</option>
            </select>
          </div>

          <!-- Availability Filter -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Availability</label>
            <select
              [value]="filters().availability"
              (change)="updateFilter('availability', $any($event.target).value)"
              class="w-full text-gray-700 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
              <option value="">All</option>
              <option value="online">Online</option>
              <option value="offline">Offline</option>
            </select>
          </div>

          <!-- Location Filter -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
            <input
              type="text"
              [value]="filters().location"
              (input)="updateFilter('location', $any($event.target).value)"
              placeholder="e.g., New York"
              class="w-full px-3 text-gray-700 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <!-- Minimum Rating Filter -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Min Rating: {{ filters().minRating || 0 }}⭐</label>
            <input
              type="range"
              min="0"
              max="5"
              step="0.5"
              [value]="filters().minRating"
              (input)="updateFilter('minRating', +$any($event.target).value)"
              class="w-full"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div *ngIf="isLoading()" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div *ngFor="let i of [1,2,3,4,5,6]" class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="animate-pulse">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-16 h-16 bg-gray-200 rounded-full"></div>
            <div class="flex-1">
              <div class="h-4 bg-gray-200 rounded w-3/4 mb-2"></div>
              <div class="h-3 bg-gray-200 rounded w-1/2"></div>
            </div>
          </div>
          <div class="space-y-2 mb-4">
            <div class="h-3 bg-gray-200 rounded"></div>
            <div class="h-3 bg-gray-200 rounded w-5/6"></div>
          </div>
          <div class="flex gap-2">
            <div class="h-6 bg-gray-200 rounded-full w-20"></div>
            <div class="h-6 bg-gray-200 rounded-full w-20"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Grid -->
  <div *ngIf="!isLoading()" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Results Count -->
    <div class="mb-6">
      <p class="text-gray-600">
        <span class="font-semibold text-gray-900">{{ displayedUsers().length }}</span>
        {{ displayedUsers().length === 1 ? 'user' : 'users' }} found
      </p>
    </div>

    <!-- Empty State: No Results -->
    <div *ngIf="displayedUsers().length === 0 && !isLoading()" class="text-center py-16">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 rounded-full mb-4">
        <lucide-icon [img]="Users" class="w-8 h-8 text-gray-400"></lucide-icon>
      </div>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">No users found</h3>
      <p class="text-gray-600 mb-6 max-w-md mx-auto">
        Try adjusting your search or filters to find more skill exchange partners.
      </p>
      <button
        (click)="clearFilters(); searchQuery.set('')"
        class="px-6 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors"
      >
        Clear All Filters
      </button>
    </div>

    <!-- User Cards Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div *ngFor="let card of displayedUsers()" class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-lg transition-shadow duration-200">
        <!-- Compatibility Badge -->
        <div class="p-4 border-b border-gray-100">
          <span [class]="'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border ' + getCompatibilityBadge(card.compatibilityLevel).class">
            <span>{{ getCompatibilityBadge(card.compatibilityLevel).icon }}</span>
            {{ getCompatibilityBadge(card.compatibilityLevel).text }}
          </span>
        </div>

        <div class="p-6">
          <!-- User Info -->
          <div class="flex items-start gap-4 mb-4">
            <div class="relative">
              <img
                [src]="card.user.photoUrl || 'https://ui-avatars.com/api/?name=' + card.user.name + '&background=6366f1&color=fff'"
                [alt]="card.user.name"
                class="w-16 h-16 rounded-full object-cover border-2 border-gray-100"
              />
              <div *ngIf="card.user.isVerified" class="absolute -bottom-1 -right-1 w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center border-2 border-white">
                <span class="text-white text-xs">✓</span>
              </div>
            </div>

            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-gray-900 truncate mb-1">{{ card.user.name }}</h3>
              
              <!-- Rating -->
              <div class="flex items-center gap-1 mb-2">
                <div class="flex items-center">
                  <span *ngFor="let filled of getStars(card.user.averageRating)" [class]="filled ? 'text-yellow-400' : 'text-gray-300'">★</span>
                </div>
                <span class="text-sm text-gray-600 ml-1">
                  {{ card.user.averageRating.toFixed(1) }} ({{ card.user.totalReviews }})
                </span>
              </div>

              <!-- Availability -->
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <span *ngIf="card.user.preferOnline" class="flex items-center gap-1">
                  <lucide-icon [img]="Wifi" class="w-3 h-3"></lucide-icon>
                  Online
                </span>
                <span *ngIf="card.user.preferOffline" class="flex items-center gap-1">
                  <lucide-icon [img]="MapPin" class="w-3 h-3"></lucide-icon>
                  {{ card.user.location || 'Offline' }}
                </span>
              </div>
            </div>
          </div>

          <!-- Bio -->
          <p *ngIf="card.user.bio" class="text-sm text-gray-600 mb-4 line-clamp-2">
            {{ card.user.bio }}
          </p>

          <!-- Skills They Teach -->
          <div class="mb-4">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Teaches</p>
            <div class="flex flex-wrap gap-1.5">
              <span
                *ngFor="let skill of card.user.skillsITeach.slice(0, 3)"
                class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800"
              >
                {{ skill.name }}
              </span>
              <span *ngIf="card.user.skillsITeach.length > 3" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                +{{ card.user.skillsITeach.length - 3 }}
              </span>
            </div>
          </div>

          <!-- Skills They Want -->
          <div class="mb-4">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Wants to Learn</p>
            <div class="flex flex-wrap gap-1.5">
              <span
                *ngFor="let skill of card.user.skillsIWantToLearn.slice(0, 3)"
                class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800"
              >
                {{ skill.name }}
              </span>
              <span *ngIf="card.user.skillsIWantToLearn.length > 3" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                +{{ card.user.skillsIWantToLearn.length - 3 }}
              </span>
            </div>
          </div>

          <!-- Matched Skills (if any) -->
          <div *ngIf="card.matchedSkills.length > 0" class="mb-4 p-3 bg-green-50 border border-green-100 rounded-lg">
            <p class="text-xs font-semibold text-green-800 mb-1">🎯 Matching Skills</p>
            <p class="text-xs text-green-700">{{ card.matchedSkills.join(', ') }}</p>
          </div>

          <!-- Stats -->
          <div class="flex items-center gap-4 text-xs text-gray-500 mb-4 pb-4 border-b border-gray-100">
            <span class="flex items-center gap-1">
              <lucide-icon [img]="Users" class="w-3.5 h-3.5"></lucide-icon>
              {{ card.user.totalSwapsCompleted }} swaps
            </span>
          </div>

          <!-- Actions -->
          <div class="flex gap-2">
            <button
              (click)="viewProfile(card.user.id)"
              class="flex-1 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-medium text-sm"
            >
              View Profile
            </button>
            <button
              *ngIf="card.compatibilityLevel !== CompatibilityLevel.NONE"
              (click)="requestSwap(card)"
              class="flex-1 px-4 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium text-sm"
            >
              Request Swap
            </button>
            <button
              *ngIf="card.compatibilityLevel === CompatibilityLevel.NONE"
              (click)="requestSwap(card)"
              class="flex-1 px-4 py-2.5 bg-gray-100 text-gray-400 rounded-lg cursor-not-allowed font-medium text-sm"
              title="No matching skills"
            >
              No Match
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
